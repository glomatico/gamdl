# Local integration tests only. Copy to .env and keep credentials private.
# Enabled only when running with GAMDL_RUN_LIVE=1 in the shell.
# Auth priority: running wrapper -> media-user-token -> Netscape cookies file.
# The wrapper is assumed to be on the local machine unless overridden.
GAMDL_WRAPPER_URL=http://127.0.0.1
GAMDL_APPLE_STOREFRONT=br

# Optional: enforce a specific source during live validation.
# GAMDL_EXPECT_AUTH_SOURCE=wrapper

# Optional fallback credentials; never commit real values.
# GAMDL_APPLE_DEVELOPER_TOKEN=
# GAMDL_APPLE_MEDIA_USER_TOKEN=
# GAMDL_APPLE_COOKIES_PATH=/path/to/cookies.txt

# Run live tests explicitly (not from .env):
# GAMDL_RUN_LIVE=1 uv run python -m unittest discover -s tests/live -v
